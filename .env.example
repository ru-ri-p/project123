# Attest configuration (env var names match app/config.py fields exactly).
# Local dev defaults shown; override per environment.
DATABASE_URL=postgresql+psycopg2://attest:devpass@localhost:5433/attest
SIGNING_BACKEND=local
SIGNING_PRIVATE_KEY_PATH=keys/ed25519_private.pem
SIGNING_PUBLIC_KEY_PATH=keys/ed25519_public.pem
# Production (UAE) custody example: SIGNING_BACKEND=kms, KMS_KEY_ID=alias/attest-prod, KMS_REGION=me-central-1
TSA_URL=https://freetsa.org/tsr
BATCH_INTERVAL_SECONDS=300
